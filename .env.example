# Copia este archivo a .env y rellena tus claves de Alpaca. NUNCA subas .env a Git.
APCA_API_KEY_ID=tu_api_key
APCA_API_SECRET_KEY=tu_secret_key

# Seguridad: debe ser "true" para permitir el modo live (dinero real)
CONFIRM_LIVE_TRADING=false

# Opcionales
SETTINGS_DB_PATH=config/settings.db
LOG_LEVEL=INFO
METRICS_PORT=9100
API_URL=http://api:8000
