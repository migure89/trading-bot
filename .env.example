# Copia este archivo a .env y rellena tus claves. NUNCA subas .env a Git.

# ---------------- Alpaca ----------------
APCA_API_KEY_ID=tu_api_key
APCA_API_SECRET_KEY=tu_secret_key

# Seguridad: debe ser "true" para permitir el modo live (dinero real) en CUALQUIER broker
CONFIRM_LIVE_TRADING=false

# ---------------- Seguridad de la API y el dashboard ----------------
# Token de la API de control. Si está definido, todas las rutas salvo /health exigen
# "Authorization: Bearer <token>" o "X-API-Key: <token>"; el dashboard lo envía solo.
# Si se deja vacío, la API arranca SIN autenticación y lo avisa en el log.
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=
# Contraseña para abrir el dashboard (vacía = sin contraseña; úsala si lo expones fuera de localhost)
DASHBOARD_PASSWORD=
# Interfaz del host en la que docker compose publica 8000, 8501 y 9100 (por defecto solo localhost)
BIND_ADDR=127.0.0.1

# ---------------- Interactive Brokers (TWS / IB Gateway) ----------------
# Ejecución local (sin Docker). Paper/live se decide por el puerto:
#   TWS: 7497 paper / 7496 live     IB Gateway: 4002 paper / 4001 live
IBKR_HOST=127.0.0.1
IBKR_PORT_PAPER=4002
IBKR_PORT_LIVE=4001
# Cada proceso conectado (bot, API, optimizador) necesita un client id distinto
IBKR_CLIENT_ID=1
# Opcional: cuenta concreta si tu login gestiona varias (las de paper empiezan por DU)
IBKR_ACCOUNT=
# true = la API solo lee (no envía órdenes); debe coincidir con la config de TWS/Gateway
IBKR_READONLY=false
IBKR_CONNECT_TIMEOUT=10
IBKR_REQUEST_TIMEOUT=60
IBKR_STOCK_EXCHANGE=SMART
IBKR_CURRENCY=USD
IBKR_CRYPTO_EXCHANGE=PAXOS
# true = históricos solo en horario regular de mercado
IBKR_USE_RTH=false
IBKR_HIST_PACING_SEC=1.0

# Con docker compose (los servicios se conectan al contenedor ib-gateway en 4004/4003).
# Para usar TWS en tu ordenador: IBKR_DOCKER_HOST=host.docker.internal y puertos 7497/7496.
IBKR_DOCKER_HOST=ib-gateway
IBKR_DOCKER_PORT_PAPER=4004
IBKR_DOCKER_PORT_LIVE=4003

# Credenciales del contenedor IB Gateway (perfil "ibkr": docker compose --profile ibkr up -d)
TWS_USERID=tu_usuario_ibkr
TWS_PASSWORD=tu_password_ibkr
TRADING_MODE=paper
READ_ONLY_API=no
VNC_SERVER_PASSWORD=
TIME_ZONE=Europe/Madrid

# ---------------- Opcionales ----------------
SETTINGS_DB_PATH=config/settings.db
LOG_LEVEL=INFO
# Fichero adicional de logs (JSON, una línea por evento); vacío = solo stdout
LOG_FILE=
# Niveles por logger de terceros, p.ej. ib_async.client=INFO,optuna=DEBUG (ib_async.client es CRITICAL por defecto)
LOG_LEVELS=
# Segundos que el bot espera a que se ejecute una orden a mercado para registrar precio/cantidad reales
ORDER_FILL_TIMEOUT=10
METRICS_PORT=9100
# Interfaz del exporter Prometheus en ejecución local (en Docker se fuerza 0.0.0.0 dentro del contenedor)
METRICS_ADDR=127.0.0.1
# URL de la API para el dashboard en ejecución local (docker compose usa http://api:8000)
API_URL=http://localhost:8000
